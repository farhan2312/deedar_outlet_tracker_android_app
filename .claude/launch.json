{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "expo-web",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set EXPO_PUBLIC_API_URL=http://localhost:3999&& set EXPO_PUBLIC_WS_URL=http://localhost:3998&& npx expo start --web --port 8082"
