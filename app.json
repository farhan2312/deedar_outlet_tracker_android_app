{
  "expo": {
    "name": "Deedar ISR",
    "slug": "deedar-isr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "deedarisr",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.shreekrishnafragrances.ddrive",
      "adaptiveIcon": {
        "backgroundColor": "#7ca081",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#7ca081",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Deedar ISR shares your location with your Sales Officer while your work day is open, even when the app is closed."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Deedar ISR lets you attach a screenshot when you report a bug.",
          "cameraPermission": "Deedar ISR lets you take a photo to attach when you report a bug.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "403bfce3-09f1-4f6f-8266-9f390e3eeeaa"
      }
    }
  }
}
